<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS: el sitio apunta a public/. Requiere el módulo URL Rewrite y PHP por FastCGI (ver docs/iis.md). -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <rule name="Quitar diagonal final" stopProcessing="true">
          <match url="^(.*)/$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
        </rule>
        <rule name="Laravel" stopProcessing="true">
          <match url="^" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- 30 MB: varias fotos de celular por envío. Debe ir de la mano con post_max_size de php.ini. -->
        <requestLimits maxAllowedContentLength="31457280" />
        <hiddenSegments>
          <add segment=".env" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- Que Laravel muestre sus propias páginas de error (419, 422, 500) en lugar de las de IIS. -->
    <httpErrors existingResponse="PassThrough" />

    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
